APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FHIR_VALIDATOR_URL=http://localhost:3500

# Per-system bearer tokens for the gateway API. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# FACILITY is the client's DOH NHFR code and becomes its read scope: a client sees only
# referrals its own facility sent or received.
GATEWAY_TOKEN_REFERRAL=
GATEWAY_FACILITY_REFERRAL=
GATEWAY_TOKEN_TELEMEDICINE=
GATEWAY_FACILITY_TELEMEDICINE=

# Client authentication modes: token, mtls, or both (comma separated).
# mtls expects a reverse proxy to verify the certificate and forward these headers.
GATEWAY_AUTH_MODES=token
GATEWAY_MTLS_VERIFY_HEADER=X-Client-Verify
GATEWAY_MTLS_FINGERPRINT_HEADER=X-Client-Fingerprint

# Where the telemedicine system accepts FHIR. Seeded into the destination registry.
TELEMEDICINE_FHIR_URL=http://localhost:8081/fhir

# Native contract endpoints (docs/native-contract.md). Leave blank until the system owners
# implement them — the gateway refuses inbound referrals it cannot pass on.
REFERRAL_INBOUND_URL=
REFERRAL_PATIENT_SEARCH_URL=
TELEMEDICINE_INBOUND_URL=
TELEMEDICINE_PATIENT_SEARCH_URL=
